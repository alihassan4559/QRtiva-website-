# NODE_ENV: Set to "production" in production deployments (Render Web Services).
NODE_ENV="production"

# PORT: Listening port assigned automatically by Render (defaults to 3000 locally).
PORT="3000"

# APP_URL: Optional public origin URL (e.g. https://qrtiva.onrender.com or https://yourdomain.com).
# Used for canonical URLs, Open Graph URLs, robots.txt, and sitemap.xml.
# If omitted, QRtiva derives the origin dynamically from request Host/X-Forwarded-* headers.
APP_URL="https://your-service.onrender.com"
